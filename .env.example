APP_NAME="PISFA Tours and Travels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pisfa_tours_travels
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# MUST be true on any HTTPS deployment. Left false here because local runs over
# plain HTTP, where a Secure cookie would never be sent and you would be unable
# to sign in. On production this is what stops the session cookie travelling in
# clear text — `pisfa:preflight` fails if it is false while APP_URL is https.
SESSION_SECURE_COOKIE=false

AUTH_PASSWORD_TIMEOUT=900

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staff invitations contain one-time account setup links. Use a real SMTP
# transport anywhere invitations can be issued; never use the log mailer there.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PISFA_DEFAULT_CURRENCY=UGX
PISFA_SUPPORTED_CURRENCIES=UGX,USD
PISFA_CONTACT_EMAIL=info@example.com
PISFA_CONTACT_PHONE=+256700000000
# Comma-separated role enum values. Per-user enforcement can add more accounts.
PISFA_TWO_FACTOR_REQUIRED_ROLES=super_admin,manager
# Maximum age, in seconds, of a pending two-factor login challenge.
PISFA_TWO_FACTOR_CHALLENGE_TTL=300
# Lifetime, in hours, of a one-time staff invitation.
PISFA_STAFF_INVITATION_EXPIRY_HOURS=72
# Tour departures use a persisted UTC cutoff and idempotent reminder window.
PISFA_TOUR_CANCELLATION_CUTOFF_HOURS=48
PISFA_TOUR_MAXIMUM_BOOKING_TRAVELERS=50
PISFA_TOUR_REMINDER_LEAD_MINUTES=1440
PISFA_TOUR_REMINDER_WINDOW_MINUTES=15
PISFA_TOUR_MAIL_MAX_PER_MINUTE=8
PISFA_CAR_HIRE_MAXIMUM_DAYS=90
PISFA_CAR_HIRE_MINIMUM_NOTICE_HOURS=2
PISFA_CAR_HIRE_CANCELLATION_CUTOFF_HOURS=48
PISFA_CAR_HIRE_PENDING_HOLD_MINUTES=1440
PISFA_PRIVATE_DOCUMENT_DISK=local
PISFA_CAR_HIRE_DOCUMENT_MAX_KB=5120
PISFA_CAR_HIRE_CONTRACT_VERSION=2026-08-20
PISFA_CAR_HIRE_MAIL_MAX_PER_MINUTE=8
PISFA_CAR_HIRE_RETURN_REMINDER_LEAD_MINUTES=1440
PISFA_CAR_HIRE_RETURN_REMINDER_WINDOW_MINUTES=15
PISFA_AIRPORT_TRANSFER_MAXIMUM_PASSENGERS=50
PISFA_AIRPORT_TRANSFER_MAXIMUM_LUGGAGE=100
PISFA_AIRPORT_TRANSFER_MINIMUM_NOTICE_HOURS=2
PISFA_AIRPORT_TRANSFER_MAXIMUM_ADVANCE_DAYS=365
PISFA_AIRPORT_TRANSFER_REQUEST_EXPIRY_MINUTES=1440
PISFA_AIRPORT_TRANSFER_CANCELLATION_CUTOFF_HOURS=4
PISFA_AIRPORT_TRANSFER_RATE_MINIMUM_DURATION_MINUTES=15
PISFA_AIRPORT_TRANSFER_RATE_MAXIMUM_DURATION_MINUTES=1440
PISFA_AIRPORT_TRANSFER_GUEST_CONFIRMATION_EXPIRY_HOURS=168
PISFA_AIRPORT_TRANSFER_MAIL_MAX_PER_MINUTE=8
PISFA_AIRPORT_TRANSFER_PICKUP_REMINDER_LEAD_MINUTES=1440
PISFA_AIRPORT_TRANSFER_PICKUP_REMINDER_WINDOW_MINUTES=15

PISFA_LOYALTY_MINOR_UNITS_PER_POINT=10000
PISFA_LOYALTY_MINIMUM_REDEMPTION=500
PISFA_LOYALTY_POINT_VALUE_MINOR=100
PISFA_LOYALTY_REFERRAL_JOIN_POINTS=100
PISFA_LOYALTY_REFERRAL_REWARD_POINTS=200
PISFA_LOYALTY_EXPIRY_MONTHS=12
PISFA_LOYALTY_EXPIRY_WARNING_DAYS=30
PISFA_LOYALTY_MAIL_MAX_PER_MINUTE=8

# Review invitations. MAX_AGE_DAYS is the safety catch: a first deployment
# against historic bookings must not mail every past customer.
PISFA_REVIEW_REQUEST_DELAY_HOURS=24
PISFA_REVIEW_REQUEST_MAX_AGE_DAYS=30
PISFA_REVIEW_REQUEST_BATCH_SIZE=100
PISFA_REVIEW_MAIL_MAX_PER_MINUTE=8

# Billing. Tax is basis points, so 18% Uganda VAT is 1800 and the rate is never
# a float. The rate in force is stamped onto each document, so changing it here
# does not restate anything already issued.
PISFA_TAX_RATE_BPS=1800
PISFA_TAX_LABEL=VAT
PISFA_QUOTATION_PREFIX=QTN
PISFA_INVOICE_PREFIX=INV
PISFA_DOCUMENT_NUMBER_PAD=5
PISFA_QUOTATION_VALIDITY_DAYS=14
PISFA_QUOTATION_MAX_ITEMS=40
PISFA_QUOTATION_MAX_QUANTITY=10000
PISFA_INVOICE_TERMS_DAYS=14
PISFA_BILLING_MAIL_MAX_PER_MINUTE=8

# Fleet. REPEAT_DAYS stops an expired document producing an identical email
# every morning, while still raising it again if nobody renews it.
PISFA_FLEET_DOCUMENT_NOTICE_DAYS=30
PISFA_FLEET_ALERT_REPEAT_DAYS=7
PISFA_FLEET_COST_WINDOW_MONTHS=12
PISFA_FLEET_UTILISATION_DAYS=30
PISFA_FLEET_MAIL_MAX_PER_MINUTE=8
# Driver licences share the fleet notice and repeat windows above.

# Hosted broadcasting is optional on shared hosting. Polling remains available.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Payment and communication providers are disabled until credentials are supplied.
MTN_MOMO_BASE_URL=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Live chat and WhatsApp (F19). Leave these blank and outbound WhatsApp falls
# back to the log transport, which records that a message was not sent rather
# than pretending it was. Inbound webhooks are refused outright without them,
# so an unconfigured deployment cannot be fed messages by anybody who finds the
# URL. Never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_SECONDS=15

# The chat widget polls, because Hostinger Premium runs no persistent WebSocket
# server. A reply reaches the customer within roughly one interval.
PISFA_CHAT_POLL_SECONDS=8
PISFA_CHAT_PAGE_SIZE=50
PISFA_CHAT_BOT_ENABLED=true
PISFA_CHAT_BOT_COOLDOWN_MINUTES=30
PISFA_MESSAGING_MAIL_MAX_PER_MINUTE=8

# Operations (F29). Health-check thresholds separate "look at this today" from
# "the site is down", which is the difference between a useful alert and one
# people learn to ignore.
PISFA_QUEUE_BACKLOG_WARNING=250
PISFA_QUEUE_STALL_MINUTES=30
PISFA_SCHEDULER_STALL_MINUTES=15

# Backups. The dump is taken through PDO, not mysqldump, because shared hosts
# routinely disable exec(). .env is never included in a backup: an archive
# holding both the encrypted data and APP_KEY gives away everything in one file.
# Point PISFA_BACKUP_DISK at a remote disk for a genuine off-site copy — a
# backup beside the database survives a bad migration, not a lost server.
PISFA_BACKUP_DISK=local
PISFA_BACKUP_PATH=backups
PISFA_BACKUP_MEDIA_DISK=local
PISFA_BACKUP_KEEP=14
PISFA_BACKUP_MAX_AGE_DAYS=60
CLOUDINARY_URL=
GOOGLE_ANALYTICS_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Company identity. These print on invoices, quotations and receipts that
# customers keep, and drive the contact details shown across the site.
PISFA_COMPANY_NAME="PISFA Tours and Travels"
# The registered name and number from the certificate of incorporation, as
# against the trading name above. These print on invoices and contracts.
PISFA_COMPANY_LEGAL_NAME="PISFA Tour and Travel Limited"
PISFA_COMPANY_REGISTRATION=80034149987265
PISFA_COMPANY_INCORPORATED_ON=2026-04-10
# From URA once registered. Left blank until then rather than invented.
PISFA_COMPANY_TIN=
PISFA_COMPANY_ADDRESS="Kitebi Starlink Building, Kitebi, Bunamwaya, Rubaga Division, Kampala, Uganda"
PISFA_CONTACT_EMAIL=info@pisfatoursandtravel.com
PISFA_CONTACT_PHONE="+256771755952"

# Digits only, country code, no plus — the shape wa.me expects.
PISFA_WHATSAPP_NUMBER=256758375435
