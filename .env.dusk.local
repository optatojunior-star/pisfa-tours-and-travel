# Environment for browser tests. Loaded by Dusk in place of .env when the
# suite runs with APP_ENV=local, and restored afterwards.
#
# It points at its own SQLite file so a browser run never touches the database
# you are developing against — Dusk drives a real server, so RefreshDatabase
# alone cannot protect it the way it does for HTTP tests.
#
# This file contains no real credentials and is safe to commit. Every external
# integration is deliberately left unconfigured, so a browser test can never
# reach a payment gateway, a mail server, or WhatsApp.

APP_NAME="PISFA Tours and Travels"
APP_ENV=local
APP_KEY=base64:KydvOZUBgw0LzLZhhPBv7eLzB4ZSeqSRfQ51EXTc0ys=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Nothing leaves the machine during a browser test.
MAIL_MAILER=log
BROADCAST_CONNECTION=null

# Vite reads the built manifest rather than a dev server, so `npm run build`
# must have run before the browser suite.
VITE_APP_NAME="${APP_NAME}"
